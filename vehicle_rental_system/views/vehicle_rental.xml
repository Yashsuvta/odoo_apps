<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="view_vehicle_form" model="ir.ui.view">
    <field name="name">vehicle.form</field>
    <field name="model">vehicle.rental</field>
    <field name="arch" type="xml">
        <form string="vehicle Rental">
            <header>
                <field name="car_status" widget="statusbar" statusbar_visible="available,rented,maintenance,sold"/>

                <button name="set_status_available"
                        string="Available"
                        type="object"
                        class="btn-success"
                        invisible="car_status in 'available'"/>
               
                <button name="set_status_rented"
                        string="Rented"
                        type="object"
                        class="btn-primary"
                        invisible="car_status in'rented'"/>
                
                <button name="set_status_maintenance"
                        string="Under Maintenance"
                        type="object"
                        class="btn-warning"
                        invisible="car_status in 'maintenance'"/>

                <button name="set_status_sold"
                        string="Sold"
                        type="object"
                        class="btn-danger"
                        invisible="car_status in 'sold'"/>

            </header>
            <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                <div class="oe_title">
                    <h1>
                        <field name="name"/>
                    </h1>
                </div>
                <notebook>
                    <page string="General Information">
                        <group>
                            <group>
                                <field name="last_odometer"/>
                                <field name="rent_price"/>
                                <field name="rent_uom_id" domain="[('category_id.name','=','Time')]"/>
                                <field name="fuel_level"/>
                            </group>
                        </group>
                    </page>

                    <page string="Vehicle Details">
                    <group>
                    <group>
                        <field name="seat_number"/>
                        <field name="door_number"/>
                        <field name="color"/>
                        <field name="model_year"/>
                        <field name="car_type"/>
                        <field name="used_for"/>
                        <field name="occupancy"/>
                        <field name="chassis_number"/>
                    </group>
                    </group>
                    </page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>

<record id="view_vehicle_kanban" model="ir.ui.view">
    <field name="name">vehicle.kanban</field>
    <field name="model">vehicle.rental</field>
    <field name="arch" type="xml">
         <kanban default_group_by="car_status" class="o_kanban_view">
            <field name="car_status"/>
            <grouped by="car_status"/>
            <progressbar field="car_status" colors='{"available": "success", "maintenance": "warning", "rented": "danger", "booked": "info", "sold": "purple"}'/>
            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_card oe_kanban_global_click">
                        <field name="image" widget="image" class="oe_kanban_image"/>
                        <div class="oe_kanban_details">
                            <strong><field name="name"/></strong>
                            <br/>
                            <span>Status: <field name="car_status"/></span>
                            <br/>
                            <span>Type: <field name="car_type"/></span>
                            <br/>
                            <span>Rent: <field name="rent_price"/></span>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>


<record id="action_car" model="ir.actions.act_window">
    <field name="name">vehicle Rental</field>
    <field name="res_model">vehicle.rental</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="view_id" ref="view_vehicle_kanban"/>
</record>
</odoo> 