<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SETTINGS VIEW -->
    <record id="view_remove_data" model="ir.ui.view">
        <field name="name">res.config.settings.remove.data</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="priority">20</field>

        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <app string="Data Cleaner" name="data_cleaner">

                    <block title="Data Cleaner">

                        <!-- WARNING -->
                        <setting string="Warning">
                            <div class="alert alert-danger">
                                <h3>⚠️ Warning: Irreversible Deletion</h3>

                                <p>
                                    Data is deleted directly from database tables.
                                    <strong>
                                        Once deleted, it cannot be recovered.
                                    </strong>
                                </p>
                            </div>
                        </setting>

                        <!-- GENERAL -->
                        <setting string="General Cleanup">

                            <button string="Delete All Transactions Except Master Data"
                                    type="object"
                                    name="remove_all"
                                    confirm="Please confirm to delete all transactional data?"
                                    class="btn btn-danger"/>

                        </setting>

                        <!-- SALES -->
                        <setting string="Sales">

                            <button string="Delete All Sales Order"
                                    type="object"
                                    name="remove_sales"
                                    confirm="Please confirm to delete all Sales Orders?"
                                    class="btn btn-outline-danger"/>

                        </setting>

                        <!-- POS -->
                        <setting string="POS">

                            <button string="Delete All POS Order"
                                    type="object"
                                    name="remove_pos"
                                    confirm="Please confirm to delete all POS Orders?"
                                    class="btn btn-outline-danger"/>

                        </setting>

                        <!-- PURCHASE -->
                        <setting string="Purchase">

                            <button string="Delete All Purchase Order and Requisition"
                                    type="object"
                                    name="remove_purchase"
                                    confirm="Please confirm to delete all Purchase Orders?"
                                    class="btn btn-outline-danger"/>

                        </setting>

                        <!-- EXPENSE -->
                        <setting string="Expense">

                            <button string="Delete All Expense and Sheet"
                                    type="object"
                                    name="remove_expense"
                                    confirm="Please confirm to delete all Expenses?"
                                    class="btn btn-outline-danger"/>

                        </setting>

                        <!-- MRP -->
                        <setting string="Manufacturing">

                            <div class="d-flex gap-2">

                                <button string="Delete All Manufacturing Order"
                                        type="object"
                                        name="remove_mrp"
                                        confirm="Please confirm to delete all Manufacturing Orders?"
                                        class="btn btn-outline-danger"/>

                                <button string="Delete All BOM"
                                        type="object"
                                        name="remove_mrp_bom"
                                        confirm="Please confirm to delete all BOMs?"
                                        class="btn btn-outline-danger"/>

                            </div>

                        </setting>

                        <!-- INVENTORY -->
                        <setting string="Inventory">

                            <button string="Delete All Move/Picking/Package/Lot"
                                    type="object"
                                    name="remove_inventory"
                                    confirm="Please confirm to delete all inventory data?"
                                    class="btn btn-outline-danger"/>

                        </setting>

                        <!-- ACCOUNT -->
                        <setting string="Accounting">

                            <div class="d-flex gap-2">

                                <button string="Delete All Voucher/Invoice/Bill"
                                        type="object"
                                        name="remove_account"
                                        confirm="Please confirm to delete all Accounting data?"
                                        class="btn btn-outline-danger"/>

                                <button string="Clean and Reset Account Chart"
                                        type="object"
                                        name="remove_account_chart"
                                        confirm="Are you sure you want to reset Account Chart?"
                                        class="btn btn-outline-warning"/>

                            </div>

                        </setting>

                        <!-- PROJECT -->
                        <setting string="Project">

                            <button string="Delete All Project/Task/Forecast"
                                    type="object"
                                    name="remove_project"
                                    confirm="Please confirm to delete all project data?"
                                    class="btn btn-outline-danger"/>

                        </setting>

                        <!-- QUALITY -->
                        <setting string="Quality">

                            <div class="d-flex gap-2">

                                <button string="Delete All Quality"
                                        type="object"
                                        name="remove_quality"
                                        confirm="Please confirm to delete all quality records?"
                                        class="btn btn-outline-danger"/>

                                <button string="Delete All Quality Setting"
                                        type="object"
                                        name="remove_quality_setting"
                                        confirm="Please confirm to delete all quality settings?"
                                        class="btn btn-outline-danger"/>

                            </div>

                        </setting>

                        <!-- WEBSITE -->
                        <setting string="Website">

                            <button string="Delete All Website/Blog"
                                    type="object"
                                    name="remove_website"
                                    confirm="Please confirm to delete all website/blog content?"
                                    class="btn btn-outline-danger"/>

                        </setting>

                        <!-- BASE -->
                        <setting string="Base Models">

                            <div class="d-flex gap-2 flex-wrap">

                                <button string="Delete All Product"
                                        type="object"
                                        name="remove_product"
                                        confirm="Please confirm to delete all Products?"
                                        class="btn btn-outline-danger"/>

                                <button string="Delete All Product Attribute"
                                        type="object"
                                        name="remove_product_attribute"
                                        confirm="Please confirm to delete all Product Attributes?"
                                        class="btn btn-outline-danger"/>

                                <button string="Delete All Message"
                                        type="object"
                                        name="remove_message"
                                        confirm="Please confirm to delete all Messages?"
                                        class="btn btn-outline-danger"/>

                                <button string="Reset Category And Location Complete Name"
                                        type="object"
                                        name="reset_cat_loc_name"
                                        class="btn btn-outline-warning"/>

                            </div>

                        </setting>

                    </block>

                </app>

            </xpath>

        </field>
    </record>

    <!-- ACTION -->
    <record id="action_remove_data" model="ir.actions.act_window">
        <field name="name">Remove Data</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
    </record>

    <!-- MENU -->
