<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="web.NavBarCustom" t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//div[@role='menu']" position="replace">
            <div class="o_menu_systray d-flex flex-shrink-0 ms-auto" role="menu">
                <i t-att-class="debugIconClass" t-on-click="toggleDebugMode" style="cursor: pointer;"></i>
                <t t-foreach="systrayItems" t-as="item" t-key="item.key">
                    <div t-att-data-index="item.index"/>
                    <ErrorHandler onError="error => this.handleItemError(error, item)">
                        <t t-component="item.Component" t-props="item.props"/>
                    </ErrorHandler>
                </t>
            </div>
        </xpath>
    </t>
</templates>
