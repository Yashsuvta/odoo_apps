<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="ExportAll" t-inherit="web.ExportAll" t-inherit-mode="extension">
        <xpath expr="//DropdownItem" position="replace">
            <DropdownItem class="'o_export_all_menu'" onSelected.bind="onDirectExportData">
                <i class="fa fa-fw fa-upload me-1"/>
                Export in Excel
            </DropdownItem>
        </xpath>
    </t>
</templates>